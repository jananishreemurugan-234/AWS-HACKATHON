# ResumePilot AI Environment Variables Example
# Copy this file to .env and fill in configuration settings when ready.
# NEVER commit real credentials, access keys, or secrets to version control.

# Application Settings
APP_ENV=development
APP_PORT=8501

# Amazon Bedrock & AWS Configuration (Stage 5)
# AWS credentials can be provided via standard AWS CLI (~/.aws/credentials),
# AWS SSO (aws sso login), IAM Role, or optional environment variables below.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Optional explicit credentials (only if not using AWS CLI / SSO / IAM roles):
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here (if using temporary credentials)
# AWS_PROFILE=default

# Strands Decider 2B Settings (Stage 4 Local System 1 Server / Ollama)
STRANDS_DECIDER_ENDPOINT=http://localhost:11434/v1/systemone
STRANDS_DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
